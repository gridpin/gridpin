{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.gridpin/gridpin-mcp",
  "title": "GridPin offline geocoder",
  "description": "Offline geocoding and reverse geocoding from one local file per country. No API key, no rate limit.",
  "websiteUrl": "https://gridpin.dev",
  "repository": {
    "url": "https://github.com/gridpin/gridpin",
    "source": "github",
    "subfolder": "mcp"
  },
  "version": "0.1.0",
  "packages": [
    {
      "registryType": "pypi",
      "registryBaseUrl": "https://pypi.org",
      "identifier": "gridpin-mcp",
      "version": "0.1.0",
      "runtimeHint": "uvx",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "GRIDPIN_HOME",
          "description": "Directory for downloaded country sheets (default: ~/.cache/gridpin)",
          "isRequired": false,
          "isSecret": false
        }
      ]
    }
  ]
}
