# Heavy data stays out of Git; the small provenance manifest must exist in a clone.
data/*
!data/de_manifest.json
eval/eval_set.parquet
eval/queries.jsonl
gridpin/target/
*.bin
# ML weights ship in the repo (the sheet builder reads them) — exempt from *.bin
!ml/parser_v0.bin
!ml/rank_v0.bin
__pycache__/
.DS_Store
eval/control/*.csv
data/wof/
duckdb-ext/target/
gridpin-ffi/target/
.r-lib
.r-lib-src/
# R package: the 1 KB test sheet ships with it; build leftovers do not
!integrations/r/gridpin/inst/extdata/tiny.bin
integrations/r/gridpin/src/Makevars
integrations/r/gridpin/src/Makevars.win
integrations/r/gridpin/src/*.o
integrations/r/gridpin/src/*.so
integrations/r/gridpin/src/*.dll
integrations/r/gridpin/src/rust/target/
integrations/r/gridpin/src/rust/vendor/
integrations/r/gridpin/src/rust/vendor.tar.xz
integrations/r/gridpin/inst/AUTHORS
duckdb-ext/build/
duckdb-ext/duckdb/
duckdb-ext/*.duckdb_extension
.wrangler/
public-bench-work/
.venv-langchain/
integrations/qgis/gridpin_geocoder.zip
